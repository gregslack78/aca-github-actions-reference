        <mxCell id="remote" value="B: build" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ea580c;fontSize=12;endArrow=block;dashed=1;" edge="1" parent="1" source="runners" target="tasks">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
