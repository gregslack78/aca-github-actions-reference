        <mxCell id="taskpush" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ea580c;fontSize=12;endArrow=block;dashed=1;" edge="1" parent="1" source="tasks" target="acr">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pull" value="managed identity pull" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;fontSize=12;endArrow=block;" edge="1" parent="1" source="acr" target="aca">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1460" y="400" />
