        <mxCell id="deploy" value="deploy + smoke test" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7c3aed;fontSize=12;endArrow=block;" edge="1" parent="1" source="runners" target="aca">
