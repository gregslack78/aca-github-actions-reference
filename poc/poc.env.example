# Copy this file to poc.env (same folder) and edit the values.
# poc.env is ignored by Git. Never put secrets in it: this POC has none.

# --- Azure ---
SUBSCRIPTION_ID=""                 # az account show --query id -o tsv
LOCATION="eastus2"                 # region with Standard_D2as_v5 quota and Container Apps support
RESOURCE_GROUP="rg-aca-gh-poc"
POC_PREFIX="acapoc"                # 3-12 lowercase letters/digits; used in resource names
SSH_PUBLIC_KEY_FILE="$HOME/.ssh/id_ed25519.pub"   # created with: ssh-keygen -t ed25519

# --- Runner sizing (the guide sizes for 15 build / 2 deploy) ---
BUILD_INSTANCE_COUNT=2
DEPLOY_INSTANCE_COUNT=1
VM_SIZE="Standard_D2as_v5"

# --- App ---
ACA_APP="hello-poc"
IMAGE_REPOSITORY="apps/hello"

# --- GitHub ---
GH_OWNER="gregslack78"             # change these defaults if using a different repository
GH_REPO="aca-github-actions-reference"
GH_REPO_VISIBILITY="public"        # matches the reference repository; scripts do not change existing visibility
GH_REVIEWER="gregslack78"          # GitHub login that must approve production deployments
GH_PREVENT_SELF_REVIEW="false"     # true to block the person who triggered a run from approving it

# --- Entra ---
BUILD_APP_NAME="gh-aca-poc-build"
DEPLOY_APP_NAME="gh-aca-poc-production"

# --- Repository protection (step 6) ---
GH_REQUIRED_APPROVALS=0           # reviews needed to merge a pull request; use 1+ when more than one person works in the repo
GH_REQUIRE_CODE_OWNERS=false      # true = CODEOWNERS must approve changes to the pipeline files (needs a second person)
